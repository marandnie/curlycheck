rules_version = '2';

// Reglas de Firestore para Curly Check.
// - Estantería: cada usuaria solo puede leer/escribir su propia data en users/{uid}/...
// - Telemetría anónima: cualquier visitante puede CREAR documentos con esquema
//   validado. Solo la admin (UID hardcodeado en isAdmin()) puede leer.
// - Admin: solo la admin puede leer/escribir admin/scans/items/*.
//
// Para deployar:
//   firebase deploy --only firestore:rules
// O pegarlas en Firebase Console > Firestore > Rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────── Estantería de usuarias ─────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /shelf/{itemId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /{collection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ───────────── Telemetría anónima (opt-out) ─────────────
    // Permitimos crear documentos sin auth pero con esquema estricto para
    // evitar abuso. Solo la admin lee — el cliente común nunca lee ni borra.
    match /telemetry/scans/events/{eventId} {
      allow create: if isValidScan(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }
    match /telemetry/contributions/events/{eventId} {
      allow create: if isValidContribution(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ───────────── Admin: scans en bulk ─────────────
    // Solo la admin (ver isAdmin()) puede leer/escribir. Validamos el shape
    // del doc resultante (request.resource.data ya viene "post-merge"
    // tanto en create como en update, así que el mismo validador alcanza).
    match /admin/scans/items/{barcode} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && isValidAdminScan(request.resource.data);
    }

    // Bloqueamos todo lo demás por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ───────────── Helpers ─────────────
// Gating admin por UID en lugar de email: el UID es opaco y no es PII,
// así que se puede commitear a un repo público sin filtrar info personal.
// El UID es de la cuenta de Marina en Firebase Auth (Authentication > Users).
function isAdmin() {
  return request.auth != null
      && request.auth.uid == "URXSAbooQiWPL2v8ck1uN1RFans1";
}

// ───────────── Validadores de esquema ─────────────
function isValidScan(d) {
  return d.keys().hasOnly([
        'barcode', 'name', 'brand', 'verdict', 'ruleset',
        'source', 'unknownIngredients', 'dayBucket', 'appVersion'
      ])
      && d.barcode is string && d.barcode.size() <= 64
      && d.name is string && d.name.size() <= 200
      && d.brand is string && d.brand.size() <= 100
      && d.verdict is string && d.verdict.size() <= 32
      && d.ruleset is string && d.ruleset.size() <= 80
      && d.source is string && d.source.size() <= 80
      && d.unknownIngredients is list && d.unknownIngredients.size() <= 50
      && d.dayBucket is string && d.dayBucket.size() <= 16
      && d.appVersion is string && d.appVersion.size() <= 16;
}

function isValidContribution(d) {
  return d.keys().hasOnly(['barcode', 'name', 'dayBucket', 'appVersion'])
      && d.barcode is string && d.barcode.size() <= 64
      && d.name is string && d.name.size() <= 200
      && d.dayBucket is string && d.dayBucket.size() <= 16
      && d.appVersion is string && d.appVersion.size() <= 16;
}

function isValidAdminScan(d) {
  return d.keys().hasOnly([
        'barcode', 'firstSeenAt', 'lastSeenAt', 'count',
        'status', 'note', 'addedBy'
      ])
      && d.barcode is string && d.barcode.size() <= 64
      && d.firstSeenAt is number
      && d.lastSeenAt is number
      && d.count is number
      && d.status in ['pendiente', 'contribuido', 'descartado']
      && d.note is string && d.note.size() <= 500
      && d.addedBy is string && d.addedBy.size() <= 200;
}
